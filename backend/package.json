{
  "name": "french-sourcing-agent-api",
  "private": true,
  "version": "0.0.0",
  "description": "Express + PostgreSQL API for French Sourcing Agent",
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "db:check": "node --env-file-if-exists=.env src/db/check.ts",
    "migrate:up": "node --env-file-if-exists=.env src/db/migrate.ts up",
    "migrate:down": "node --env-file-if-exists=.env src/db/migrate.ts down",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language sql",
    "db:seed": "node --env-file-if-exists=.env src/cli/seedSampleData.ts",
    "user:role": "node --env-file-if-exists=.env src/cli/setUserRole.ts",
    "mail:outbox": "node --env-file-if-exists=.env src/cli/showOutbox.ts",
    "test": "node --env-file-if-exists=.env --test \"test/**/*.test.ts\"",
    "test:cleanup": "node --env-file-if-exists=.env src/cli/removeTestAccounts.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "~6.0.3"
  }
}
