# Copy to backend/.env and fill in your local values. Never commit .env.

NODE_ENV=development
# API port (the Vite site runs on 3001 and proxies /api here)
PORT=4000
# The website's origin, used for links in verification and password reset emails
APP_ORIGIN=http://localhost:3001

# PostgreSQL connection. The app shares events_monitor_db with the Drouot collector: its own tables
# live in DB_SCHEMA (every connection's search_path), and it reads sales and lots from the
# collector's drouot_collector schema through views (AUCTION_MONITOR.md). Never point it at public.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=events_monitor_db
DB_SCHEMA=sourcing_agent
DB_USER=postgres
DB_PASSWORD=change-me
# true when the server requires TLS (certificates are verified)
DB_SSL=false
# Maximum pooled connections
DB_POOL_MAX=10

# Comma-separated browser origins allowed to call the API (never *)
CORS_ORIGINS=http://localhost:3001

# Authentication
# Signs CSRF tokens; at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-with-at-least-32-random-characters
# Sessions end after this much inactivity, and after the maximum age however active they are
SESSION_IDLE_MINUTES=720
SESSION_MAX_AGE_HOURS=168
# Secure cookies (HTTPS only). Defaults to true when NODE_ENV=production, and can't be false there.
COOKIE_SECURE=false
# Number of trusted reverse proxies in front of the API, for client IPs in rate limiting
TRUST_PROXY_HOPS=0

# Collection API on port 3000. Keep the Bearer token only in backend/.env.
collection_root=http://localhost:3000/api/collections
collection_token=

# Site search: the taxonomy search service (taxonomy_search/INTEGRATION.md). Use the same token as
# taxonomy_search/.env; keep it only in the two .env files — it never reaches the browser.
TAXONOMY_SERVICE_URL=http://127.0.0.1:8000
TAXONOMY_SERVICE_TOKEN=
