# Copy to backend/.env and fill in your local values. Never commit .env.

NODE_ENV=development
# API port (the Vite site runs on 3000 and proxies /api here)
PORT=4000
# The website's origin, used for links in verification and password reset emails
APP_ORIGIN=http://localhost:3000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=french_sourcing_agent_db
DB_USER=postgres
DB_PASSWORD=change-me
# true when the server requires TLS (certificates are verified)
DB_SSL=false
# Maximum pooled connections
DB_POOL_MAX=10

# Comma-separated browser origins allowed to call the API (never *)
CORS_ORIGINS=http://localhost:3000

# Authentication
# Signs CSRF tokens; at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-with-at-least-32-random-characters
# Sessions end after this much inactivity, and after the maximum age however active they are
SESSION_IDLE_MINUTES=720
SESSION_MAX_AGE_HOURS=168
# Secure cookies (HTTPS only). Defaults to true when NODE_ENV=production, and can't be false there.
COOKIE_SECURE=false
# Number of trusted reverse proxies in front of the API, for client IPs in rate limiting
TRUST_PROXY_HOPS=0

# AI lot search via the auction monitor's n8n workflow. Set the key only in backend/.env.
N8N_SEARCH_WEBHOOK_URL=http://localhost:5678/webhook/auctionmonitor/search
N8N_SEARCH_API_KEY=
