# Copy to .env and adjust. .env is git-ignored; never commit real credentials.

# --- Source database (existing Drouot data, read-only for this project) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=events_monitor_db
DB_SCHEMA=drouot_collector
# Leave DB_USER / DB_PASSWORD empty to use libpq defaults (OS user, ~/.pgpass, PGUSER/PGPASSWORD).
DB_USER=
DB_PASSWORD=
# Per-statement timeout for inspection/analysis queries (milliseconds).
DB_STATEMENT_TIMEOUT_MS=120000

# --- Application schema (created from Phase 2 onwards, after approval) ---
APP_SCHEMA=auction_search

# --- Output and logging ---
REPORTS_DIR=reports
LOG_LEVEL=INFO
# text (human-readable key=value) or json (one JSON object per line)
LOG_FORMAT=text

# --- Embeddings (Phase 5): local model, no paid API ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_DEVICE=cpu      # default: Apple GPU (mps) when available

# Shared secret between the Sourcing agent's back end and this service (header X-Service-Token).
# Required for every endpoint except /api/health; the admin API refuses to run without it.
# Put the same value in ../backend/.env. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TAXONOMY_SERVICE_TOKEN=
